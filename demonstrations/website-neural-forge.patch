diff --git a/tests/neural-routes.test.mjs b/tests/neural-routes.test.mjs
new file mode 100644
index 0000000..2b40008
--- /dev/null
+++ b/tests/neural-routes.test.mjs
@@ -0,0 +1,10 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {registerHooks} from 'node:module';
+registerHooks({resolve(specifier,context,next){if(specifier==='cloudflare:workers')return {url:'data:text/javascript,export const env={}',shortCircuit:true};return next(specifier,context);}});
+const {default:worker}=await import('../dist/server/index.js');
+async function render(url){const r=await worker.fetch(new Request('http://localhost'+url,{headers:{accept:'text/html'}}),{ASSETS:{fetch:async()=>new Response('Not found',{status:404})}},{waitUntil(){},passThroughOnException(){}});assert.equal(r.status,200);return r.text();}
+test('ANNA overview preserves independent authorization boundaries',async()=>{const h=await render('/anna');assert.match(h,/ANNA 1\.3 orchestration/);assert.match(h,/unapproved/);assert.match(h,/href="\/anna-neural"/);});
+test('Neural evidence page renders real metrics and disclosure',async()=>{const h=await render('/anna-neural');assert.match(h,/97\.61%/);assert.match(h,/96\.72%/);assert.match(h,/owner review/);assert.match(h,/No GPU or custom Tesla hardware/);assert.match(h,/architecture\.svg/);});
+test('Existing development projects retain home navigation',async()=>{const h=await render('/');assert.match(h,/AETERNA 3\.0/);assert.match(h,/concordia\/index.html/);assert.match(h,/SAMARA/);assert.match(h,/href="\/anna"/);});
+test('Existing records route still renders',async()=>{const h=await render('/records');assert.match(h,/AETERNA/);assert.match(h,/Concordia/);});
